# ============ OpenAI ============
OPENAI_API_KEY=your_openai_api_key_here

# ============ 国内模型 API Keys ============
# DeepSeek (深度求索) —— https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 通义千问 (Qwen) —— https://dashscope.aliyuncs.com
QWEN_API_KEY=your_qwen_api_key_here

# 智谱 GLM (Zhipu) —— https://open.bigmodel.cn
ZHIPU_API_KEY=your_zhipu_api_key_here
# GLM_API_KEY 也可作为别名（与 ZHIPU_API_KEY 二选一）
GLM_API_KEY=your_glm_api_key_here

# Kimi (Moonshot / 月之暗面) —— https://platform.moonshot.cn
MOONSHOT_API_KEY=your_moonshot_api_key_here

# MiniMax —— https://platform.MiniMax.com
MINIMAX_API_KEY=your_minimax_api_key_here

# 百度文心一言 (Ernie Bot) —— 需 secret key 走特殊协议
BAIDU_API_KEY=your_baidu_api_key_here
BAIDU_SECRET_KEY=your_baidu_secret_key_here

# 讯飞星火 (Spark) —— 需 app_id + secret 走特殊协议
SPARK_APP_ID=your_spark_app_id_here
SPARK_API_KEY=your_spark_api_key_here
SPARK_SECRET_KEY=your_spark_secret_key_here

# 字节豆包 (Doubao / 火山方舟 ARK) —— https://www.volcengine.com/product/ark
DOUBAO_API_KEY=your_doubao_api_key_here

# 腾讯混元 (Hunyuan) —— https://hunyuan.tencent.com
HUNYUAN_API_KEY=your_hunyuan_api_key_here

# 硅基流动 (SiliconFlow) —— https://siliconflow.cn
# 一站式聚合 Qwen/DeepSeek/GLM 等
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ============ 模型配置 ============
# 模型提供商：
#   openai / deepseek / qwen / zhipu / moonshot / minimax /
#   baidu / spark / doubao / hunyuan / siliconflow
MODEL_PROVIDER=deepseek

# 模型名称（可选，不填则使用各提供商的默认模型）
MODEL_NAME=deepseek-chat

# ============ 其他配置 ============
# 网络搜索
SERPAPI_API_KEY=your_serpapi_api_key_here

# ============ MCP / 第三方服务器 ============
# GitHub MCP —— https://github.com/settings/tokens (需要 repo / read:org 等权限)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here

# Brave Search MCP —— https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Slack MCP —— https://api.slack.com/apps (Bot Token xoxb-..., Team ID T...)
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_TEAM_ID=your_slack_team_id_here

# SQLite MCP —— 数据库文件路径(相对项目根目录)
DATABASE_PATH=./data.db

# ---------- MiniMax 官方 MCP ----------
# 注册地址:国内 https://platform.minimaxi.com / 国际 https://platform.minimax.io
# API Key 与 API HOST 必须同区域,否则会 invalid api key
MINIMAX_API_KEY=
# 本地输出目录(MCP 内部写文件用),必须有写权限
MINIMAX_MCP_BASE_PATH=./output/minimax
# 国内:https://api.minimax.chat  /  国际:https://api.minimaxi.chat(注意多一个 i)
MINIMAX_API_HOST=https://api.minimax.chat
# 资源返回方式:url(默认,链接 24h 过期) | local(本地保存)
MINIMAX_API_RESOURCE_MODE=url

# 日志级别
LOG_LEVEL=INFO
