# web_console/Dockerfile.nginx — Nginx 反向代理镜像（生产环境）
#
# 多阶段构建：
#   Stage 1 (web-builder): node:20-alpine 构建前端 dist
#   Stage 2 (nginx):       nginx:1.27-alpine + dist + nginx.conf
#
# 与 web_console/Dockerfile 并存：
#   - Dockerfile         → 单容器 backend + dist（开发/CI smoke test）
#   - Dockerfile.nginx   → 生产 nginx 反代 + dist（本文件）
#
# 构建： docker build -f web_console/Dockerfile.nginx -t ai-agent-web:2.0.11 .

# ──────────────── Stage 1: 前端构建 ────────────────
FROM node:20-alpine AS web-builder

WORKDIR /build/web_console

# 1) 依赖文件先复制，利用 Docker layer cache
COPY web_console/package.json web_console/package-lock.json* ./
RUN npm ci --no-audit --no-fund

# 2) 源代码 + 构建
COPY web_console/ ./
RUN npm run build

# ──────────────── Stage 2: Nginx 镜像 ────────────────
FROM nginx:1.27-alpine

# 替换默认配置
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/nginx.conf

# 复制构建产物到 nginx 静态目录
COPY --from=web-builder /build/web_console/dist /usr/share/nginx/html

# 健康检查（用 wget 因 alpine 默认无 curl）
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/api/health || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
